# Exclude node_modules to avoid bloating the build context and ensure npm install runs inside the container
node_modules
**/node_modules

# Exclude local production builds
dist
**/dist

# Exclude sensitive environment variables and credentials
.env
**/.env
.env.local
**/.env.local

# Exclude git repository metadata
.git
**/.git

# Exclude log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude editor and OS metadata
.DS_Store
Thumbs.db
.vscode
.idea
